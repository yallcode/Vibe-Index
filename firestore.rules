rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid in [
        '440QtDjzU7RYumA18x6h7BagIMi2',
        'RtupX72YrbYPK7ai4ot0Lbu3oCo1'
      ];
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /mods/{modId} {
      allow read: if resource.data.status == 'approved'
        || (request.auth != null && resource.data.authorId == request.auth.uid)
        || isAdmin();

      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.downloadUrl is string
        && request.resource.data.downloadUrl.size() > 0;

      allow update: if isAdmin()
        || (
          resource.data.diff(request.resource.data).affectedKeys().hasOnly(['downloads'])
          && request.resource.data.downloads == resource.data.downloads + 1
        );

      allow delete: if isAdmin();
    }
  }
}
